# Copy to .env.local. Never commit .env.local.

# generate a random secret: `openssl rand -base64 32`
AUTH_SECRET=****

# Local Postgres (see README): docker run -d --name ra-postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=chatbot -p 5432:5432 postgres:16-alpine
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/chatbot

# USE_MOCK=1 serves fake model answers (no key needed). Set USE_MOCK=0 + ANTHROPIC_API_KEY to use Claude.
USE_MOCK=1
ANTHROPIC_API_KEY=
# The coach (/api/coach) uses OpenAI gpt-6-luna when USE_MOCK=0.
OPENAI_API_KEY=

# Optional, leave unset: Vercel Blob (file uploads), Redis (resumable streams)
# BLOB_READ_WRITE_TOKEN=
# REDIS_URL=
