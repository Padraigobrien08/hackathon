# Copy to .env.local. Never commit .env.local.

# generate a random secret: `openssl rand -base64 32`
AUTH_SECRET=****

# Local Postgres (see README): docker run -d --name ra-postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=chatbot -p 5432:5432 postgres:16-alpine
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/chatbot

# USE_MOCK=1 serves fake model answers (no key needed). Set USE_MOCK=0 + OPENAI_API_KEY for real answers.
# Chat uses gpt-6.1-sol; titles and the coach use gpt-6-luna.
USE_MOCK=1
OPENAI_API_KEY=

# Optional, leave unset: Vercel Blob (file uploads), Redis (resumable streams)
# BLOB_READ_WRITE_TOKEN=
# REDIS_URL=
